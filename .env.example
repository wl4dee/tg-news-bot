# Скопіюй у .env і підстав свої значення. Файл .env у .gitignore — у репозиторій
# він не потрапляє, а PreToolUse-хук додатково блокує спроби його закомітити.
#
# Потім:  python -m tests.doctor    — перевірить кожну ланку й скаже, що зламано
#         DRY_RUN=1 python -m bot.main   — повний прогін без відправки

TELEGRAM_BOT_TOKEN=
DRAFTS_CHAT_ID=
GEMINI_API_KEY=

# Необов'язкові: без них сухий прогін працює, просто без черги рішень з KV.
CF_ACCOUNT_ID=
CF_KV_TOKEN=

# Необов'язкові налаштування механіки:
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_PAUSE_SEC=7
# GEMINI_THINKING_BUDGET=0
# DRY_RUN=1
